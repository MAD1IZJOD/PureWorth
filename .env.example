# Local development needs none of the optional services below.
PUREWORTH_ENV=local
# Hosted environments stay blocked unless protected access and Redis are ready.
PUREWORTH_ACCESS=blocked
# Use a unique cryptographically random 32–256 character value; never NEXT_PUBLIC_.
PUREWORTH_BETA_TOKEN=
# Server-only Upstash HTTPS origin and REST token from your own approved account.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Enable only after private storage, retention and consent have been reviewed.
PUREWORTH_FEEDBACK=false
PUREWORTH_ANALYTICS=false
# Live providers, checkout and ordering are hard-disabled in server code.
